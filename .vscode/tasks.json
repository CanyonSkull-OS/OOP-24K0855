{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build SFML Project",
            "type": "shell",
            "command": "g++",
            "args": [
                "-IC:/SFML-master/include",
                "-LC:/SFML-build/lib",
                "${workspaceFolder}/temp.cpp",
                "-o",
                "${workspaceFolder}/main.exe",
                "-lsfml-graphics",
                "-lsfml-window",
                "-lsfml-system"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"],
            "detail": "Generated task for compiling SFML with MinGW"
        }
    ]
}
